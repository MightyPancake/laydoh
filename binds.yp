Clay_CornerRadius fn corner_radius_all(f32 radius);
Clay_Padding fn padding_all(i32 padding);
Clay_Color fn color(f32 r, f32 g, f32 b, f32 a);

// Setters for the real uint16_t/int16_t fields split into _lo/_hi byte pairs
// above -- these hide that split entirely.
none fn set_child_gap(Clay_LayoutConfig@ layout, i32 gap);
none fn set_font_size(Clay_TextElementConfig@ cfg, i32 font_size);
none fn set_border_widths(Clay_BorderWidth@ w, i32 left, i32 right, i32 top, i32 bottom, i32 between_children);
none fn set_floating_z_index(Clay_FloatingElementConfig@ f, i32 z);

// Thin malloc passthrough -- see wrapper.c for why this exists instead of
// `import stdlib`.
none@ fn malloc(i64 size);
