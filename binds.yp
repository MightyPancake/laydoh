    Clay_SizingAxis height,
}

struct Clay_Padding {
    byte left_lo, // uint16_t left, low byte (little-endian)
    byte left_hi, // uint16_t left, high byte
    byte right_lo, // uint16_t right, low byte (little-endian)
    byte right_hi, // uint16_t right, high byte
    byte top_lo, // uint16_t top, low byte (little-endian)
    byte top_hi, // uint16_t top, high byte
    byte bottom_lo, // uint16_t bottom, low byte (little-endian)
    byte bottom_hi, // uint16_t bottom, high byte
}

struct Clay_LayoutConfig {
    Clay_Sizing sizing,
    Clay_Padding padding,
    byte childGap_lo, // uint16_t childGap, low byte (little-endian)
    byte childGap_hi, // uint16_t childGap, high byte
    Clay_ChildAlignment childAlignment,
    byte layoutDirection,
}

