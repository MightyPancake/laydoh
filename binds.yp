    byte right_hi, // uint16_t right, high byte
    byte top_lo, // uint16_t top, low byte (little-endian)
    byte top_hi, // uint16_t top, high byte
    byte bottom_lo, // uint16_t bottom, low byte (little-endian)
    byte bottom_hi, // uint16_t bottom, high byte
