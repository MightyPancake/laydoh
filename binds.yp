// C bindings from /home/mightypancake/laydoh/third_party/clay/clay.h
//
// clay.h declares most of its enums via CLAY_PACKED_ENUM (`enum
// __attribute__((__packed__))` on gcc/clang), which stores them in a single
// byte instead of the compiler's default (4-byte) enum representation. yap's
// `enum` has no way to request that packing, so any struct field whose real
// C type is one of those packed enums is declared here as plain `u8`
// instead of the named enum type -- matching Clay's actual in-memory layout
// bit for bit. (The two enums clay.h itself leaves unpacked, Clay_TransitionState
// and Clay_TransitionProperty, keep their real enum type below.) Compare/assign
// these fields through the enum, e.g. `cmd.commandType ==
// Clay_RenderCommandType.CLAY_RENDER_COMMAND_TYPE_TEXT.(u8)`.

bind type Clay_Context

bind struct Clay_String {
    bool isStaticallyAllocated,
    i32 length,
    u8@ chars,
}

bind struct Clay_StringSlice {
    i32 length,
    u8@ chars,
    u8@ baseChars,
}

bind struct Clay_Arena {
    u64 nextAllocation,
    u64 capacity,
    u8@ memory,
}

bind struct Clay_Dimensions {
    f32 width,
    f32 height,
}

bind struct Clay_Vector2 {
    f32 x,
    f32 y,
}

bind struct Clay_Color {
    f32 r,
    f32 g,
    f32 b,
    f32 a,
}

bind struct Clay_BoundingBox {
    f32 x,
    f32 y,
    f32 width,
    f32 height,
}

bind struct Clay_ElementId {
    u32 id,
    u32 offset,
    u32 baseId,
    Clay_String stringId,
}

bind struct Clay_ElementIdArray {
    i32 capacity,
    i32 length,
    Clay_ElementId@ internalArray,
}

