// C bindings from /home/mightypancake/laydoh/third_party/clay/clay.h
//
// clay.h declares most of its enums via CLAY_PACKED_ENUM (`enum
// __attribute__((__packed__))` on gcc/clang), which stores them in a single
// byte instead of the compiler's default (4-byte) enum representation. yap's
// `enum` has no way to request that packing, so any struct field whose real
// C type is one of those packed enums is declared here as plain `byte`
// instead of the named enum type -- matching Clay's actual in-memory layout
// bit for bit. (The two enums clay.h itself leaves unpacked, Clay_TransitionState
// and Clay_TransitionProperty, keep their real enum type below.) Compare/assign
// these fields with plain integer literals matching each enum's declaration
// order (e.g. commandType: NONE=0, RECTANGLE=1, BORDER=2, TEXT=3, IMAGE=4,
// SCISSOR_START=5, SCISSOR_END=6, OVERLAY_COLOR_START=7, OVERLAY_COLOR_END=8,
// CUSTOM=9) -- yap also has no surface syntax yet to reference an enum
// variant by name as a value, only to cast an int literal to the enum type.
//
// clay.h also has a number of real `uint16_t`/`int16_t` fields (Padding,
// BorderWidth, childGap, TextElementConfig's font metrics, zIndex, ...), and
// yap has no 16-bit integer primitive at all (only byte/i32/u32/i64/u64/f32/
// f64) -- bindgen silently widened every one of these to `i32`, which is a
// real struct-layout bug, not just a range mismatch: it shifts every field
// declared after the widened one by 2 bytes relative to Clay's actual memory
// layout, corrupting reads through the real struct built by wrapper.c. Each
// such field is instead declared here as two `byte` fields, `<name>_lo` and
// `<name>_hi` (little-endian, matching x86-64), giving the exact same total
// size as the real field with no extra padding -- reconstruct the value as
// `lo | (hi << 8)`, or just use the `set_*`/`*_all` constructor helpers below
// which do this in C and never expose the halves. This does not change how
// these structs are passed by value across the yap/wrapper.c boundary: the
// x86-64 SysV ABI classifies small all-integer aggregates by size alone, so
// "4 uint16_t" and "8 byte" fields both fall in the same one-eightbyte
// INTEGER class and are passed/returned identically.

type Clay_Context

struct Clay_String {
    bool isStaticallyAllocated,
    i32 length,
    byte@ chars,
}

struct Clay_StringSlice {
    i32 length,
    byte@ chars,
    byte@ baseChars,
}

struct Clay_Arena {
    i64 nextAllocation,
    i64 capacity,
    byte@ memory,
}

struct Clay_Dimensions {
    f32 width,
    f32 height,
}

struct Clay_Vector2 {
    f32 x,
    f32 y,
}

struct Clay_Color {
    f32 r,
    f32 g,
    f32 b,
    f32 a,
}

struct Clay_BoundingBox {
    f32 x,
    f32 y,
    f32 width,
    f32 height,
}

struct Clay_ElementId {
    i32 id,
    i32 offset,
    i32 baseId,
    Clay_String stringId,
}

struct Clay_ElementIdArray {
    i32 capacity,
    i32 length,
    Clay_ElementId@ internalArray,
}

struct Clay_CornerRadius {
    f32 topLeft,
    f32 topRight,
    f32 bottomLeft,
    f32 bottomRight,
}

enum Clay_LayoutDirection {
    CLAY_LEFT_TO_RIGHT,
    CLAY_TOP_TO_BOTTOM,
}

enum Clay_LayoutAlignmentX {
