// Hand-written ergonomic helpers -- see wrapper.c. Not part of clay.h itself;
// these fill in for the C compound-literal / designated-initializer syntax
// (CLAY_SIZING_*, CLAY_PADDING_ALL, CLAY_CORNER_RADIUS, CLAY_STRING, ...)
// that yap has no equivalent surface syntax for.
Clay_ElementDeclaration fn zero_element_declaration();
Clay_TextElementConfig fn zero_text_element_config();
Clay_String fn string_from_cstr(byte@ s);
Clay_SizingAxis fn sizing_fixed(f32 size);
