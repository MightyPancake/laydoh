// Fuller demo: a hero panel and a row of 3 cards, laid out by clay.h through laydoh.
// Dumps the render commands to stdout ("R ..." rectangles, "T ... <text>" text) for an
// external script to render; this program never touches pixels.
import laydoh
import io

none fn on_error(Clay_ErrorData err) {
    printf:(c"clay error: %s\n", {err.errorText.chars});
}

Clay_Dimensions fn measure_text(Clay_StringSlice text, Clay_TextElementConfig@ config, none@ user_data) {
    i32 font_size = config.fontSize.(i32);
    ret {.width = text.length.(f32) * (font_size.(f32) * 0.56), .height = font_size.(f32) * 1.2};
}

i32 fn main() {
    u64 mem_size = min_memory_size();
    Clay_Arena arena = create_arena(mem_size, malloc(mem_size));
    Clay_Dimensions screen = {.width = 800.0, .height = 500.0};
    Clay_ErrorHandler handler = {.errorHandlerFunction = on_error, .userData = null};
    arena:initialize(screen, handler);
    set_measure_text_function(measure_text, null);

    u8 top_to_bottom = Clay_LayoutDirection.CLAY_TOP_TO_BOTTOM.(u8);

    begin_layout();

    Clay_ElementDeclaration root = {
        .backgroundColor = color(19.0, 24.0, 33.0, 255.0),
        .layout = {
            .sizing = {.width = sizing_grow(0.0, 0.0), .height = sizing_grow(0.0, 0.0)},
            .layoutDirection = top_to_bottom,
            .padding = padding_all(20),
        },
    };
    root.layout.childGap = 14;
    element:(#root@, {
        Clay_ElementDeclaration hero = {
            .backgroundColor = color(34.0, 43.0, 58.0, 255.0),
            .cornerRadius = corner_radius_all(10.0),
            .layout = {
                .sizing = {.width = sizing_grow(0.0, 0.0), .height = sizing_fit(0.0, 0.0)},
                .layoutDirection = top_to_bottom,
                .padding = padding_all(16),
            },
        };
        hero.layout.childGap = 8;
        element:(#hero@, {
            text(c"laydoh + yap + clay.h", 245.0, 245.0, 245.0, 36);
            text(c"UI layout logic written in yap, executed through the real clay.h C library via generated bindings.", 200.0, 205.0, 215.0, 20);
        });

        Clay_ElementDeclaration cards_row = {
            .layout = {
                .sizing = {.width = sizing_grow(0.0, 0.0), .height = sizing_grow(0.0, 0.0)},
                .layoutDirection = Clay_LayoutDirection.CLAY_LEFT_TO_RIGHT.(u8),
            },
        };
        cards_row.layout.childGap = 12;
        element:(#cards_row@, {
            for (i32 i = 0; i < 3; i++) {
                Clay_ElementDeclaration card = {
                    .backgroundColor = color(40.0 + i.(f32) * 10.0, 55.0 + i.(f32) * 8.0, 76.0 + i.(f32) * 6.0, 255.0),
                    .cornerRadius = corner_radius_all(8.0),
                    .layout = {
                        .sizing = {.width = sizing_grow(0.0, 0.0), .height = sizing_fit(0.0, 0.0)},
                        .layoutDirection = top_to_bottom,
                        .padding = padding_all(14),
                    },
                };
                card.layout.childGap = 8;
                element:(#card@, {
                    if (i == 0) {
                        text(c"Responsive layout", 230.0, 230.0, 230.0, 24);
                        text(c"Sizing GROW/FIT and padding computed by the real Clay algorithm.", 180.0, 180.0, 180.0, 18);
                    } else if (i == 1) {
                        text(c"Real bindings", 230.0, 230.0, 230.0, 24);
                        text(c"Generated with yap --gen-c-bind, then hand-patched for callbacks.", 180.0, 180.0, 180.0, 18);
                    } else {
                        text(c"Render commands", 230.0, 230.0, 230.0, 24);
                        text(c"Walked below and dumped as plain text for external rendering.", 180.0, 180.0, 180.0, 18);
                    }
                });
            }
        });
    });

    Clay_RenderCommandArray commands = end_layout(0.016);

    for (i32 ci = 0; ci < commands.length; ci++) {
        Clay_RenderCommand@ cmd = commands:get(ci);
        Clay_BoundingBox box = cmd.boundingBox;
        i32 x = box.x.(i32);
        i32 y = box.y.(i32);
        i32 w = box.width.(i32);
        i32 h = box.height.(i32);

        if (cmd.commandType == Clay_RenderCommandType.CLAY_RENDER_COMMAND_TYPE_RECTANGLE.(u8)) {
            Clay_RectangleRenderData rect = cmd.renderData.rectangle;
            Clay_Color c = rect.backgroundColor;
            printf:(c"R %d %d %d %d %d %d %d %d %d\n", {x, y, w, h,
                c.r.(i32), c.g.(i32), c.b.(i32), c.a.(i32), rect.cornerRadius.topLeft.(i32)});
        } else if (cmd.commandType == Clay_RenderCommandType.CLAY_RENDER_COMMAND_TYPE_TEXT.(u8)) {
            Clay_TextRenderData t = cmd.renderData.text;
            Clay_Color c = t.textColor;
            i32 fs = t.fontSize.(i32);
            i32 tlen = t.stringContents.length;
            printf:(c"T %d %d %d %d %d %d %d %d %d %d ", {x, y, w, h,
                c.r.(i32), c.g.(i32), c.b.(i32), c.a.(i32), fs, tlen});
            // Clay strings aren't NUL-terminated, so print by length.
            for (i32 j = 0; j < tlen; j++) putchar(t.stringContents.chars[j].(i32));
            putchar(10);
        }
    }

    ret 0;
}
