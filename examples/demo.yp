// Fuller demo: a hero panel + a row of 3 cards, mirroring nullptr's clay.h
// WASM demo layout but driven entirely from yap through the laydoh bindings.
// After Clay_EndLayout(), the render commands are dumped to stdout in a tiny
// line-oriented format ("R ..." for rectangles, "T ... <text>" for text) so
// an external script can turn them into a real rendering for inspection --
// this program itself never touches pixels, only Clay's layout math.
import laydoh
import stdlib
import io

none fn on_error(Clay_ErrorData err) {
    io->print:(c"clay error: %s\n", [err.errorText.chars]);
}

Clay_Dimensions fn measure_text(Clay_StringSlice text, Clay_TextElementConfig@ config, none@ user_data) {
    i32 font_size;
    font_size = config:[0].fontSize_lo.(i32) + (config:[0].fontSize_hi.(i32) * 256);

    Clay_Dimensions dims;
    dims.width = text.length.(f32) * (font_size.(f32) * 0.56);
    dims.height = font_size.(f32) * 1.2;
    ret dims;
}

i32 fn main() {
    i32 mem_size;
    mem_size = laydoh->min_memory_size();
    none@ memory;
    memory = stdlib->malloc(mem_size.(i64));

    Clay_Arena arena;
    arena = laydoh->create_arena(mem_size.(i64), memory);

    Clay_Dimensions screen;
    screen.width = 800.0;
    screen.height = 500.0;

    Clay_ErrorHandler handler;
    handler.errorHandlerFunction = on_error;
    handler.userData = null;

    arena:initialize(screen, handler);
    laydoh->set_measure_text_function(measure_text, null.(none@));

    laydoh->begin_layout();

    Clay_ElementDeclaration root;
    root = laydoh->zero_element_declaration();
    root.backgroundColor = laydoh->color(19.0, 24.0, 33.0, 255.0);
    root.layout.sizing.width = laydoh->sizing_grow(0.0, 0.0);
    root.layout.sizing.height = laydoh->sizing_grow(0.0, 0.0);
    root.layout.layoutDirection = 1;
    root.layout.padding = laydoh->padding_all(20);
    laydoh->set_child_gap(root.layout@, 14);
    laydoh->element:(#root@, {
        Clay_ElementDeclaration hero;
        hero = laydoh->zero_element_declaration();
        hero.backgroundColor = laydoh->color(34.0, 43.0, 58.0, 255.0);
        hero.cornerRadius = laydoh->corner_radius_all(10.0);
        hero.layout.sizing.width = laydoh->sizing_grow(0.0, 0.0);
        hero.layout.sizing.height = laydoh->sizing_fit(0.0, 0.0);
        hero.layout.layoutDirection = 1;
        hero.layout.padding = laydoh->padding_all(16);
        laydoh->set_child_gap(hero.layout@, 8);
        laydoh->element:(#hero@, {
            laydoh->text(c"laydoh + yap + clay.h", 245.0, 245.0, 245.0, 36);
            laydoh->text(c"UI layout logic written in yap, executed through the real clay.h C library via generated bindings.", 200.0, 205.0, 215.0, 20);
        });

        Clay_ElementDeclaration cards_row;
        cards_row = laydoh->zero_element_declaration();
        cards_row.layout.sizing.width = laydoh->sizing_grow(0.0, 0.0);
        cards_row.layout.sizing.height = laydoh->sizing_grow(0.0, 0.0);
        cards_row.layout.layoutDirection = 0;
        laydoh->set_child_gap(cards_row.layout@, 12);
        laydoh->element:(#cards_row@, {
            i32 i = 0;
            while (i < 3) {
                Clay_ElementDeclaration card;
                card = laydoh->zero_element_declaration();
                card.backgroundColor = laydoh->color(40.0 + i.(f32) * 10.0, 55.0 + i.(f32) * 8.0, 76.0 + i.(f32) * 6.0, 255.0);
                card.cornerRadius = laydoh->corner_radius_all(8.0);
                card.layout.sizing.width = laydoh->sizing_grow(0.0, 0.0);
                card.layout.sizing.height = laydoh->sizing_fit(0.0, 0.0);
                card.layout.layoutDirection = 1;
                card.layout.padding = laydoh->padding_all(14);
                laydoh->set_child_gap(card.layout@, 8);
                laydoh->element:(#card@, {
                    if (i == 0) {
                        laydoh->text(c"Responsive layout", 230.0, 230.0, 230.0, 24);
                        laydoh->text(c"Sizing GROW/FIT and padding computed by the real Clay algorithm.", 180.0, 180.0, 180.0, 18);
                    } else if (i == 1) {
                        laydoh->text(c"Real bindings", 230.0, 230.0, 230.0, 24);
                        laydoh->text(c"Generated with yap --gen-c-bind, then hand-patched for callbacks.", 180.0, 180.0, 180.0, 18);
                    } else {
                        laydoh->text(c"Render commands", 230.0, 230.0, 230.0, 24);
                        laydoh->text(c"Walked below and dumped as plain text for external rendering.", 180.0, 180.0, 180.0, 18);
                    }
                });
                i = i + 1;
            }
        });
    });

    Clay_RenderCommandArray commands;
    commands = laydoh->end_layout(0.016);

    i32 ci = 0;
    while (ci < commands.length) {
        Clay_RenderCommand@ cmd;
        cmd = commands:get(ci);

        i32 x; i32 y; i32 w; i32 h;
        x = cmd:[0].boundingBox.x.(i32);
        y = cmd:[0].boundingBox.y.(i32);
        w = cmd:[0].boundingBox.width.(i32);
        h = cmd:[0].boundingBox.height.(i32);

        if (cmd:[0].commandType == 1) {
            i32 r; i32 g; i32 b; i32 a; i32 cr;
            r = cmd:[0].renderData.rectangle.backgroundColor.r.(i32);
            g = cmd:[0].renderData.rectangle.backgroundColor.g.(i32);
            b = cmd:[0].renderData.rectangle.backgroundColor.b.(i32);
            a = cmd:[0].renderData.rectangle.backgroundColor.a.(i32);
            cr = cmd:[0].renderData.rectangle.cornerRadius.topLeft.(i32);
            io->print:(c"R %d %d %d %d %d %d %d %d %d\n", [x, y, w, h, r, g, b, a, cr]);
        } else if (cmd:[0].commandType == 3) {
            i32 r; i32 g; i32 b; i32 a; i32 fs; i32 tlen;
            r = cmd:[0].renderData.text.textColor.r.(i32);
            g = cmd:[0].renderData.text.textColor.g.(i32);
            b = cmd:[0].renderData.text.textColor.b.(i32);
            a = cmd:[0].renderData.text.textColor.a.(i32);
            fs = cmd:[0].renderData.text.fontSize_lo.(i32) + (cmd:[0].renderData.text.fontSize_hi.(i32) * 256);
            tlen = cmd:[0].renderData.text.stringContents.length;
            io->print:(c"T %d %d %d %d %d %d %d %d %d %d ", [x, y, w, h, r, g, b, a, fs, tlen]);
            byte@ chars;
            chars = cmd:[0].renderData.text.stringContents.chars;
            i32 j = 0;
            while (j < tlen) {
                io->putchar(chars:[j].(i32));
                j = j + 1;
            }
            io->putchar(10);
        }

        ci = ci + 1;
    }

    ret 0;
}
