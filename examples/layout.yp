// One fixed-size element, laid out with clay.h's raw Clay_* API (no laydoh sugar).
import laydoh
import io

none fn on_error(Clay_ErrorData err) {
    printf:(c"clay error: %s\n", {err.errorText.chars});
}

Clay_Dimensions fn measure_text(Clay_StringSlice text, Clay_TextElementConfig@ config, none@ user_data) {
    ret {.width = text.length.(f32) * 8.0, .height = 16.0};
}

i32 fn main() {
    u64 mem_size = Clay_MinMemorySize().(u64);
    Clay_Arena arena = Clay_CreateArenaWithCapacityAndMemory(mem_size, malloc(mem_size));
    Clay_Dimensions screen = {.width = 800.0, .height = 600.0};
    Clay_ErrorHandler handler = {.errorHandlerFunction = on_error, .userData = null};
    Clay_Initialize(arena, screen, handler);
    Clay_SetMeasureTextFunction(measure_text, null);

    Clay_BeginLayout();

    Clay_ElementDeclaration root = zero_element_declaration();
    root.backgroundColor = color(30.0, 40.0, 55.0, 255.0);
    root.cornerRadius = corner_radius_all(8.0);
    root.layout.sizing = {.width = sizing_fixed(200.0), .height = sizing_fixed(100.0)}.(Clay_Sizing);
    root.layout.padding = padding_all(10);

    Clay__OpenElement();
    Clay__ConfigureOpenElementPtr(root@);
    Clay__CloseElement();

    Clay_RenderCommandArray commands = Clay_EndLayout(0.016);
    printf:(c"render command count: %d\n", {commands.length});

    Clay_RenderCommand@ cmd = Clay_RenderCommandArray_Get(commands@, 0);
    if (cmd != null) {
        printf:(c"first command bg.r = %d\n", {cmd.renderData.rectangle.backgroundColor.r.(i32)});
    }
    ret 0;
}
