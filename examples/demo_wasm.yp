// Live, JS-driven variant of demo.yp: docs/renderer.js calls app_update every frame
// and reads the packed draw commands back out of wasm memory.
// Build with `yap -bcc=emcc`; there is no main(), so yap adds -s INVOKE_RUN=0.
//
// Scrolling is the browser's own (native overflow on #content), not Clay's: culling is off
// so offscreen content is still emitted, and Clay never moves anything to scroll.
//
// Draw command layout, DRAW_COMMAND_SIZE (36) bytes, packed by hand (yap has no #pragma pack);
// keep docs/renderer.js in sync:
//   +0 i32 type (1 = rect, 2 = text)   +4 f32 x   +8 f32 y   +12 f32 width   +16 f32 height
//   +20..23 u8 r, g, b, a              +24/25 font size lo/hi   +26/27 text length lo/hi
//   +28 i32 text pointer (0 for rects) +32 i32 corner radius (0 for text)
import laydoh

i32 MAX_DRAW_COMMANDS = 64;
i32 DRAW_COMMAND_SIZE = 36;

bool initialized = false;
f32 elapsed = 0.0;
i32 draw_command_count = 0;
u8[2304] draw_commands; // MAX_DRAW_COMMANDS * DRAW_COMMAND_SIZE

// No io here (it doesn't build for wasm), so layout errors are dropped.
none fn on_error(Clay_ErrorData err) {}

Clay_Dimensions fn measure_text(Clay_StringSlice text, Clay_TextElementConfig@ config, none@ user_data) {
    i32 font_size = config.fontSize.(i32);
    ret {.width = text.length.(f32) * font_size.(f32) * 0.56, .height = font_size.(f32) * 1.2};
}

none fn write_i32(i32 addr, i32 val) {
    addr.(i32@). = val;
}

none fn write_f32(i32 addr, f32 val) {
    addr.(f32@). = val;
}

none fn write_byte(i32 addr, i32 val) {
    addr.(u8@). = val.(u8);
}

none fn write_command(i32 addr, i32 kind, Clay_BoundingBox box, Clay_Color color) {
    write_i32(addr + 0, kind);
    write_f32(addr + 4, box.x);
    write_f32(addr + 8, box.y);
    write_f32(addr + 12, box.width);
    write_f32(addr + 16, box.height);
    write_byte(addr + 20, color.r.(i32));
    write_byte(addr + 21, color.g.(i32));
    write_byte(addr + 22, color.b.(i32));
    write_byte(addr + 23, color.a.(i32));
}

none fn write_rect_command(i32 addr, Clay_RenderCommand@ cmd) {
    write_command(addr, 1, cmd.boundingBox, cmd.renderData.rectangle.backgroundColor);
    for (i32 k = 24; k < 28; k++) write_byte(addr + k, 0);
    write_i32(addr + 28, 0);
    write_i32(addr + 32, cmd.renderData.rectangle.cornerRadius.topLeft.(i32));
}

none fn write_text_command(i32 addr, Clay_RenderCommand@ cmd) {
    Clay_TextRenderData text = cmd.renderData.text;
    i32 length = text.stringContents.length;
    write_command(addr, 2, cmd.boundingBox, text.textColor);
    write_byte(addr + 24, text.fontSize.(i32) % 256);
    write_byte(addr + 25, text.fontSize.(i32) / 256);
    write_byte(addr + 26, length % 256);
    write_byte(addr + 27, length / 256);
    write_i32(addr + 28, text.stringContents.chars.(i32));
    write_i32(addr + 32, 0);
}

i32 fn app_init(i32 width, i32 height) {
    Clay_Dimensions screen = {.width = width.(f32), .height = height.(f32)};
    if (initialized) {
        set_layout_dimensions(screen);
        ret 0;
    }
    initialized = true;

    u64 min_mem = min_memory_size();
    Clay_Arena arena = create_arena(min_mem, malloc(min_mem));
    Clay_ErrorHandler handler = {.errorHandlerFunction = on_error, .userData = null};
    arena:initialize(screen, handler);
    set_measure_text_function(measure_text, null);
    set_culling_enabled(false); // offscreen content must still be emitted for native scrolling
    ret 0;
}

i32 fn app_update(i32 width, i32 height, f32 dt) {
    app_init(width, height);
    set_layout_dimensions({.width = width.(f32), .height = height.(f32)});
    elapsed += dt;

    // Triangle wave in [0, 1] over 4s: animates card 0 so its text visibly reflows.
    f32 period = 4.0;
    f32 phase = elapsed - (elapsed / period).(i32).(f32) * period;
    f32 half = period / 2.0;
    f32 tri = phase < half ? phase / half else 2.0 - phase / half;
    f32 card0_width = 160.0 + tri * 200.0;
    f32 card0_h_padding = 14.0 + tri * 96.0; // stacked cards are full-width, so animate padding instead

    // Below 600px the row can't fit card 0's animated width without overflowing the viewport.
    bool stacked = width < 600;
    u8 top_to_bottom = Clay_LayoutDirection.CLAY_TOP_TO_BOTTOM.(u8);
    u8 cards_direction = stacked ? top_to_bottom else Clay_LayoutDirection.CLAY_LEFT_TO_RIGHT.(u8);
    // FIT when stacked: a GROW row spreads leftover height evenly over FIT children.
    Clay_SizingAxis cards_row_height = stacked ? sizing_fit(0.0, 0.0) else sizing_grow(0.0, 0.0);

    begin_layout();

    // .clip.vertical is required: without it Clay clamps root's children to the viewport height.
    Clay_ElementDeclaration root = {
        .backgroundColor = color(19.0, 24.0, 33.0, 255.0),
        .clip = {.horizontal = false, .vertical = true, .childOffset = {.x = 0.0, .y = 0.0}},
        .layout = {
            .sizing = {.width = sizing_grow(0.0, 0.0), .height = sizing_fit(0.0, 0.0)},
            .layoutDirection = top_to_bottom,
            .padding = padding_all(20),
        },
    };
    root.layout.childGap = 14;
    element:(#root@, {
        Clay_ElementDeclaration hero = {
            .backgroundColor = color(34.0, 43.0, 58.0, 255.0),
            .cornerRadius = corner_radius_all(10.0),
            .layout = {
                .sizing = {.width = sizing_grow(0.0, 0.0), .height = sizing_fit(0.0, 0.0)},
                .layoutDirection = top_to_bottom,
                .padding = padding_all(16),
            },
        };
        hero.layout.childGap = 8;
        element:(#hero@, {
            text(c"Hello from laydoh! YAP bindings for clay.h :D", 245.0, 245.0, 245.0, 36);
            text(c"Layout logic is written in yap and ran live with bindings clay.h C library. This is running almost entirely in WASM!", 200.0, 205.0, 215.0, 20);
        });

        Clay_ElementDeclaration cards_row = {
            .layout = {
                .sizing = {.width = sizing_grow(0.0, 0.0), .height = cards_row_height},
                .layoutDirection = cards_direction,
            },
        };
        cards_row.layout.childGap = 12;
        element:(#cards_row@, {
            for (i32 i = 0; i < 3; i++) {
                Clay_SizingAxis card_width = sizing_grow(0.0, 0.0);
                Clay_Padding card_padding = padding_all(14);
                if (i == 0) {
                    if (stacked) card_padding = padding_xy(card0_h_padding.(i32), 14);
                    else card_width = sizing_fixed(card0_width);
                }

                Clay_ElementDeclaration card = {
                    .backgroundColor = color(40.0 + i.(f32) * 10.0, 55.0 + i.(f32) * 8.0, 76.0 + i.(f32) * 6.0, 255.0),
                    .cornerRadius = corner_radius_all(8.0),
                    .layout = {
                        .sizing = {.width = card_width, .height = sizing_fit(0.0, 0.0)},
                        .layoutDirection = top_to_bottom,
                        .padding = card_padding,
                    },
                };
                card.layout.childGap = 8;
                element:(#card@, {
                    if (i == 0) {
                        text(c"Live resize", 230.0, 230.0, 230.0, 24);
                        if (stacked) {
                            text(c"This card's text area is animated every frame from yap. Watch the card grow and shrink as it reflows.", 180.0, 180.0, 180.0, 18);
                        } else {
                            text(c"This card's width is animated every frame from yap. Watch this text reflow as it narrows and widens.", 180.0, 180.0, 180.0, 18);
                        }
                    } else if (i == 1) {
                        text(c"Lorem ipsum", 230.0, 230.0, 230.0, 24);
                        text(c"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.", 180.0, 180.0, 180.0, 18);
                    } else {
                        text(c"All star", 230.0, 230.0, 230.0, 24);
                        text(c"Somebody once told me, the world is gonna roll me. I ain't the sharpest tool in the shed.", 180.0, 180.0, 180.0, 18);
                    }
                });
            }
        });
    });

    Clay_RenderCommandArray commands = end_layout(dt);

    i32 base = draw_commands[0]@.(i32);
    draw_command_count = 0;
    for (i32 ci = 0; ci < commands.length && draw_command_count < MAX_DRAW_COMMANDS; ci++) {
        Clay_RenderCommand@ cmd = commands:get(ci);
        i32 addr = base + draw_command_count * DRAW_COMMAND_SIZE;
        if (cmd.commandType == Clay_RenderCommandType.CLAY_RENDER_COMMAND_TYPE_RECTANGLE.(u8)) {
            write_rect_command(addr, cmd);
            draw_command_count++;
        } else if (cmd.commandType == Clay_RenderCommandType.CLAY_RENDER_COMMAND_TYPE_TEXT.(u8)) {
            write_text_command(addr, cmd);
            draw_command_count++;
        }
    }
    ret 0;
}

i32 fn app_get_draw_commands() {
    ret draw_commands[0]@.(i32);
}

i32 fn app_get_draw_command_count() {
    ret draw_command_count;
}
